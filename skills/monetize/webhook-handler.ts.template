// Extract the bits we need from a Polar subscription payload.
// Polar's payload shapes vary slightly across event types, so be defensive.
function extractSubscription(event: any) {
  const sub = event.data;
  const customer = sub.customer || {};
  return {
    subscriptionId: sub.id as string,
    customerId: (customer.id || sub.customer_id) as string,
    email: (customer.email || sub.customer_email) as string,
    productId: (sub.product?.id || sub.product_id) as string,
    status: sub.status as string,
    currentPeriodEnd: sub.current_period_end || sub.ends_at,
  };
}

export async function POST(request: Request) {
  const body = await request.text();
  const headersList = await headers();

  // standard-webhooks signature verification
  const webhookHeaders = {
    'webhook-id': headersList.get('webhook-id') || '',
    'webhook-timestamp': headersList.get('webhook-timestamp') || '',
    'webhook-signature': headersList.get('webhook-signature') || '',
  };

  let event: any;
  try {
    const verified = polarWebhook.verify(body, webhookHeaders);
    event = typeof verified === 'string' ? JSON.parse(verified) : verified;
  } catch (err) {
    console.error('[Webhook] Signature verification failed:', err);
    return NextResponse.json({ error: 'Invalid signature' }, { status: 400 });
  }

  try {
    switch (event.type) {
      case 'subscription.created':
      case 'subscription.active': {
        const s = extractSubscription(event);

        if (s.productId !== polarProductId) {
          console.warn(`[Webhook] Unknown product: ${s.productId} — skipping`);
          break;
        }

        // Deterministic key generation — repeat events for same customer
        // produce the same key (idempotent re-issue on renewal)
        const licenseKey = generateLicenseKey(s.customerId);

        await saveLicense({
          licenseKey,
          email: s.email,
          polarCustomerId: s.customerId,
          polarSubscriptionId: s.subscriptionId,
          polarProductId: s.productId,
          status: 'active',
          currentPeriodEnd: s.currentPeriodEnd
            ? new Date(s.currentPeriodEnd)
            : undefined,
        });

        // Only email on subscription.created (avoid spamming on renewals)
        if (event.type === 'subscription.created') {
          await sendLicenseEmail(s.email, licenseKey, '{{PRODUCT_NAME}}');
        }

        console.log(
          `[Webhook] License issued/refreshed: ${licenseKey} → ${s.email}`
        );
        break;
      }

      case 'subscription.updated': {
        // Plan change — re-provision in case the product/tier shifted.
        // For single-product setups this is mostly a no-op; for multi-tier
        // products you'd update the tier in the DB here.
        const s = extractSubscription(event);
        if (s.status === 'active' && s.productId === polarProductId) {
          const licenseKey = generateLicenseKey(s.customerId);
          await saveLicense({
            licenseKey,
            email: s.email,
            polarCustomerId: s.customerId,
            polarSubscriptionId: s.subscriptionId,
            polarProductId: s.productId,
            status: 'active',
            currentPeriodEnd: s.currentPeriodEnd
              ? new Date(s.currentPeriodEnd)
              : undefined,
          });
        }
        console.log(`[Webhook] Subscription updated: ${s.subscriptionId}`);
        break;
      }

      case 'subscription.canceled': {
        // Customer hit "cancel" — they keep access until current_period_end.
        // DO NOT revoke yet. Polar fires subscription.revoked when access
        // actually ends.
        const s = extractSubscription(event);
        const cancelAt = s.currentPeriodEnd
          ? new Date(s.currentPeriodEnd)
          : new Date();
        await markPendingCancel(s.subscriptionId, cancelAt);
        console.log(
          `[Webhook] Pending cancel (active until ${cancelAt}): ${s.subscriptionId}`
        );
        break;
      }

      case 'subscription.revoked': {
        // Subscription has actually ended. Revoke now.
        const s = extractSubscription(event);
        await revokeLicense(s.subscriptionId);
        console.log(`[Webhook] Revoked: ${s.subscriptionId}`);
        break;
      }

      default:
        console.log(`[Webhook] Unhandled event type: ${event.type}`);
    }

    return NextResponse.json({ received: true });
  } catch (err) {
    console.error('[Webhook] Error processing event:', err);
    return NextResponse.json(
      { error: 'Webhook handler failed' },
      { status: 500 }
    );
  }
}

// Note: in Next.js App Router, request.text() gives us the raw body which
// is what standard-webhooks needs for signature verification. No special
// bodyParser config needed (unlike Pages Router with Stripe).

