import { headers } from 'next/headers';
import { NextResponse } from 'next/server';
import { Webhook } from 'standardwebhooks';
import crypto from 'crypto';

const webhookSecret = process.env.POLAR_WEBHOOK_SECRET!;
const polarProductId = process.env.POLAR_PRODUCT_ID!;
const polarWebhook = new Webhook(webhookSecret);

// License key generation — deterministic from Polar customer id so repeat
// events for the same customer produce the same key (idempotent).
function generateLicenseKey(
  customerId: string,
  productPrefix: string = '{{PRODUCT_PREFIX}}'
): string {
  const hash = crypto
    .createHash('sha256')
    .update(`${customerId}:${productPrefix}:v1`)
    .digest('hex');
  const keyParts = hash.slice(0, 16).match(/.{4}/g)!;
  return `${productPrefix}-${keyParts.join('-').toUpperCase()}`;
}

