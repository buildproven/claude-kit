/**
 * Pricing Component Template
 *
 * Product: {{PRODUCT_NAME}}
 * Framework: React + Tailwind CSS
 *
 * Features:
 * - Monthly/Annual toggle with discount highlight
 * - Feature comparison list
 * - Polar.sh hosted checkout (direct redirect, no checkout-session API call)
 * - Loading and error states
 * - Responsive design
 *
 * Dependencies:
 * - React 18+
 * - Tailwind CSS
 * - lucide-react (icons)
 */

'use client';

import { useState, useCallback } from 'react';
import { Check, Loader2, Zap } from 'lucide-react';

// ============================================================================
// TYPES
// ============================================================================

type BillingInterval = 'monthly' | 'annual' | 'lifetime';

interface PricingPlan {
  id: string;
  name: string;
  description: string;
  monthlyPrice: number;
  annualPrice: number;
  lifetimePrice?: number;
  features: string[];
  highlighted?: boolean;
  polarCheckoutUrlMonthly: string;
  polarCheckoutUrlAnnual: string;
  polarCheckoutUrlLifetime?: string;
}

interface PricingProps {
  plans?: PricingPlan[];
  showLifetime?: boolean;
  onCheckout?: (checkoutUrl: string) => Promise<void>;
}

// ============================================================================
// DEFAULT CONFIGURATION
// ============================================================================

