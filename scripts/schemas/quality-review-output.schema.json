{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "needs-attention"],
      "description": "Use approve only when findings is empty; use needs-attention when findings contains one or more items."
    },
    "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "findings": {
      "type": "array",
      "description": "Material findings. This must be empty for an approve verdict and non-empty for a needs-attention verdict.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "body",
          "failure_scenario",
          "file",
          "line_start",
          "proof",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "body": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "failure_scenario": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "file": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "line_start": { "type": "integer", "minimum": 1 },
          "proof": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "evidence"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["reproduction", "regression-test", "static-analysis"]
              },
              "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
