        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/product-completion.test.js",
            "scripts/__tests__/quality-run.test.js",
            "scripts/__tests__/quality-invocation.test.js",
            "scripts/__tests__/quality-runtime-dir.test.js"
