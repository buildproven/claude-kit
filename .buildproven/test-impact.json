        "scripts/__tests__/quality-provider-runtime.test.js"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-codex-cache-guard.test.js",
            "scripts/__tests__/quality-provider-runtime.test.js"
          ]
        }
      ]
    },
    {
      "paths": [
        "scripts/quality-stamp-and-merge.sh",
        "scripts/quality-validate-review-trailers.sh",
        "scripts/quality-review-check.js"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-merge-gates.test.js",
            "scripts/__tests__/quality-review-check.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/quality-wrapper.js"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-approval-scope.test.js"
          ]
        }
      ]
    },
    {
      "paths": [
        "scripts/quality-run.js",
        "scripts/__tests__/quality-run.test.js",
        "docs/quality-run-orchestrator.md",
        "skills/quality/SKILL.md",
        "skills/quality/reference.md"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-run.test.js",
            "scripts/__tests__/quality-invocation.test.js",
            "scripts/__tests__/quality-merge-gates.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/quality-risk-resolve.sh"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-gemini-runtime.test.js",
            "scripts/__tests__/quality-invocation.test.js",
