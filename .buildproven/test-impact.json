{
  "version": 1,
  "jsRunner": "vitest",
  "mappings": [
    {
      "paths": [
        "config/compute-governor-policy.json",
        "scripts/compute-governor.js",
        "scripts/provider-run.sh",
        "scripts/overnight-loop.sh",
        "skills/ralph/reference.md"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/compute-governor.test.js",
            "scripts/__tests__/provider-native.test.js",
            "scripts/__tests__/overnight-loop.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/quality-mutation-check.sh"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-mutation-check.test.js"
          ]
        }
      ]
    },
    {
      "paths": [".github/workflows/quality.yml"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-workflow-bootstrap.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/setup-codex-skill-profile.sh"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/setup-codex-skill-profile.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/quality-required-checks.js"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-required-checks.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/quality-review-plan.sh"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-provider-runtime.test.js"
          ]
        }
      ]
    },
    {
      "paths": [
        "scripts/quality-stamp-and-merge.sh",
        "scripts/quality-validate-review-trailers.sh",
        "scripts/quality-review-check.js"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-merge-gates.test.js",
            "scripts/__tests__/quality-review-check.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["scripts/quality-wrapper.js"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-approval-scope.test.js"
          ]
        }
      ]
    },
    {
      "paths": [
        "scripts/quality-run.js",
        "scripts/__tests__/quality-run.test.js",
        "docs/quality-run-orchestrator.md",
        "skills/quality/SKILL.md",
        "skills/quality/reference.md"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-run.test.js",
            "scripts/__tests__/quality-invocation.test.js",
            "scripts/__tests__/quality-merge-gates.test.js"
          ]
        }
      ]
    },
    {
      "paths": [
        "scripts/quality-authorize-merge.sh",
        "scripts/quality-invocation.js",
        "scripts/quality-protected-nonstrict.js",
        "scripts/quality-repo-lease.js"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/quality-approval-scope.test.js",
            "scripts/__tests__/quality-invocation.test.js",
            "scripts/__tests__/quality-merge-gates.test.js",
            "scripts/__tests__/quality-protected-nonstrict.test.js",
            "scripts/__tests__/quality-repo-lease.test.js"
          ]
        }
      ]
    },
    {
      "paths": ["README.md", "commands/**/*.md"],
      "commands": [
        {
          "executable": "npm",
          "args": ["run", "check:commands"]
        }
      ]
    },
    {
      "paths": ["agents/**/*.md", "skills/**/*.md"],
      "commands": [
        {
          "executable": "npm",
          "args": ["run", "test:patterns"]
        }
      ]
    },
    {
      "paths": ["scripts/block-push-main.sh"],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/branch-guard-hooks.test.js"
          ]
        }
      ]
    },
    {
      "paths": [
        "scripts/steward/discover-active-repos.py",
        "scripts/__tests__/steward-discovery.test.js"
      ],
      "commands": [
        {
          "executable": "npx",
          "args": [
            "vitest",
            "run",
            "scripts/__tests__/steward-discovery.test.js"
          ]
        }
      ]
    }
  ],
  "audits": [
    {
      "paths": [
        "package.json",
        "package-lock.json",
        "vitest.config.*",
        ".github/workflows/quality.yml",
        "scripts/test-impact.js",
        ".buildproven/test-impact.json"
      ],
      "reason": "test dependency or selector contract changed",
      "commands": [
        {
          "executable": "npm",
          "args": ["test"]
        }
      ]
    }
  ],
  "fallback": [
    {
      "executable": "npm",
      "args": ["test"]
    }
  ]
}
